#!/bin/bash
#PBS -o out_fcn_W8A32
#PBS -e err_fcn_W8A32
#PBS -l select=1:ncpus=4:mem=128GB:ngpus=1:gpu_type=v100
#PBS -N fcn_W8A32
#PBS -A 
#PBS -q casper
#PBS -j oe
#PBS -l walltime=00:30:00

# ── environment ──────────────────────────────────────────────
module purge
module load gcc cuda
module load conda
conda activate e2s

export CC=gcc CXX=g++
export CUDA_VISIBLE_DEVICES=0
export TORCH_EXTENSIONS_DIR=/glade/derecho/scratch/ananyo/.torch_extensions
export EARTH2STUDIO_CACHE=/glade/derecho/scratch/ananyo/e2s_cache
export TMPDIR=/glade/derecho/scratch/ananyo/tmp
export HDF5_USE_FILE_LOCKING=FALSE

CONFIG=W8A32
OUTDIR=/glade/derecho/scratch/ananyo/WeatherQuantization/outputs_V100/fcn_bench/${CONFIG}
mkdir -p $OUTDIR

# ── diagnostics ──────────────────────────────────────────────
echo "========================================="
echo "Job:    $PBS_JOBID"
echo "Config: $CONFIG"
echo "Node:   $(hostname)"
echo "GPU:    $(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null)"
echo "Torch:  $(python -c 'import torch; print(torch.__version__, torch.cuda.is_available())')"
echo "Start:  $(date)"
echo "========================================="

# ── run ──────────────────────────────────────────────────────
cd /glade/derecho/scratch/ananyo/WeatherQuantization/src
python -u fcn_new.py --config $CONFIG --outdir $OUTDIR

echo "End: $(date)"
echo "Done: $CONFIG"
